<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ListPokerApp.ViewModels"
             x:Class="ListPokerApp.Pages.NewGamePage"
             x:DataType="vm:NewGameViewModel"
             Title="Новая игра">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Новая игра" FontSize="24" />
        <Button Text="Начать" Command="{Binding StartCommand}" HorizontalOptions="Start" />
        <Button Text="Отмена" Command="{Binding CancelCommand}" HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>
