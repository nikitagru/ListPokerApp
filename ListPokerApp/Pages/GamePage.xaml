<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ListPokerApp.ViewModels"
             x:Class="ListPokerApp.Pages.GamePage"
             x:DataType="vm:GameViewModel"
             Title="Таблица игры">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Таблица игры" FontSize="24" />
        <Label Text="{Binding GameId, StringFormat='Игра {0}'}" />
        <Button Text="← Игры" Command="{Binding BackToGamesCommand}" HorizontalOptions="Start" />
        <Button Text="Игроки" Command="{Binding PlayersCommand}" HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>
